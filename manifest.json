{
  "manifest_version": 3,
  "name": "Gemini Canvas Markdown to Clipboard",
  "version": "1.0.0",
  "description": "GeminiのCanvasで開いているファイルをワンクリックで Markdown 形式としてクリップボードにコピーします。",
  "permissions": ["activeTab", "scripting", "clipboardRead", "clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}
